---
const slides = [
  { image: "/media/hero-estrena.webp", alt: "Joven descubre las soluciones de Economic Sales con su nueva computadora", label: "Estrena" },
  { image: "/media/hero-crea.webp", alt: "Profesional trabajando con su tableta y servicios tecnológicos", label: "Crea" },
  { image: "/media/hero-inspira.webp", alt: "Joven usa su teléfono y explora nuevas posibilidades digitales", label: "Inspira" },
  { image: "/media/hero-soluciones.webp", alt: "Selección de equipos, servicios y soluciones de Economic Sales", label: "Soluciones" },
  { image: "/media/hero-progreso.webp", alt: "Tecnología e innovación representadas en una propuesta creativa", label: "Progreso" },
  { image: "/media/hero-20-anos.webp", alt: "Emblema del aniversario número 20 de Economic Sales de México", label: "20 años", anniversary: true },
];
---
<section class="hero-carousel" aria-label="Galería de Economic Sales" data-carousel>
  <div class="carousel-heading">
    <span class="carousel-eyebrow"><i></i> Tecnología que impulsa</span>
    <span class="carousel-counter" data-counter>01 <span>/</span> 05</span>
  </div>
  <div class="carousel-stage" aria-live="off">
    <div class="carousel-orbit orbit-a"></div><div class="carousel-orbit orbit-b"></div>
    {slides.map((slide, index) => <div class:list={["carousel-slide", slide.anniversary && "slide-anniversary", index === 0 && "is-active"]} aria-hidden={index !== 0} role="group" aria-roledescription="diapositiva" aria-label={`${index + 1} de ${slides.length}`}>
      <img src={slide.image} alt={slide.alt} loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} decoding="async" />
    </div>)}
    <div class="stage-shade"></div>
    <span class="stage-spark spark-one"></span><span class="stage-spark spark-two"></span>
  </div>
  <div class="carousel-toolbar">
    <button class="carousel-control previous" type="button" aria-label="Imagen anterior" data-previous>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <div class="carousel-dots" role="group" aria-label="Elegir imagen">
      {slides.map((slide, index) => <button class:list={["carousel-dot", index === 0 && "is-active"]} type="button" aria-label={`Mostrar imagen ${index + 1}: ${slide.label}`} aria-current={index === 0 ? "true" : undefined} data-slide-to={index}><span></span></button>)}
    </div>
    <button class="carousel-control" type="button" aria-label="Pausar carrusel" data-toggle-autoplay>
      <svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
      <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
    </button>
    <button class="carousel-control next" type="button" aria-label="Imagen siguiente" data-next>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </div>
</section>
<script>
  const carousel = document.querySelector<HTMLElement>("[data-carousel]");

  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>(".carousel-slide"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-slide-to]"));
    const counter = carousel.querySelector<HTMLElement>("[data-counter]");
    const toggle = carousel.querySelector<HTMLButtonElement>("[data-toggle-autoplay]");
    const stage = carousel.querySelector<HTMLElement>(".carousel-stage");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let activeIndex = 0;
    let timer: number | undefined;
    let touchStartX: number | undefined;
    let userPaused = reducedMotion.matches;

    const stopTimer = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const startTimer = () => {
      stopTimer();
      if (userPaused || document.hidden) return;
      timer = window.setInterval(() => showSlide(activeIndex + 1), 6500);
    };

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex;
        dot.classList.toggle("is-active", isActive);
        if (isActive) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      if (counter) counter.innerHTML = `0${activeIndex + 1} <span>/</span> 0${slides.length}`;
      startTimer();
    };

    carousel.querySelector("[data-previous]")?.addEventListener("click", () => showSlide(activeIndex - 1));
    carousel.querySelector("[data-next]")?.addEventListener("click", () => showSlide(activeIndex + 1));
    dots.forEach((dot) => dot.addEventListener("click", () => showSlide(Number(dot.dataset.slideTo))));
    stage?.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "touch") touchStartX = event.clientX;
    });
    stage?.addEventListener("pointerup", (event) => {
      if (touchStartX === undefined) return;
      const distance = event.clientX - touchStartX;
      touchStartX = undefined;
      if (Math.abs(distance) > 45) showSlide(activeIndex + (distance < 0 ? 1 : -1));
    });
    stage?.addEventListener("pointercancel", () => { touchStartX = undefined; });

    toggle?.addEventListener("click", () => {
      userPaused = !userPaused;
      toggle.setAttribute("aria-label", userPaused ? "Reanudar carrusel" : "Pausar carrusel");
      carousel.classList.toggle("is-paused", userPaused);
      startTimer();
    });

    carousel.addEventListener("mouseenter", stopTimer);
    carousel.addEventListener("mouseleave", startTimer);
    carousel.addEventListener("focusin", stopTimer);
    carousel.addEventListener("focusout", (event) => {
      if (!carousel.contains(event.relatedTarget as Node | null)) startTimer();
    });
    document.addEventListener("visibilitychange", startTimer);
    reducedMotion.addEventListener("change", (event) => {
      if (event.matches) {
        userPaused = true;
        carousel.classList.add("is-paused");
        toggle?.setAttribute("aria-label", "Reanudar carrusel");
        stopTimer();
      }
    });

    carousel.classList.toggle("is-paused", userPaused);
    if (userPaused) toggle?.setAttribute("aria-label", "Reanudar carrusel");
    startTimer();
  }
</script>
<style>
  .hero-carousel { width: min(100% - 2rem, 1480px); margin: clamp(1.3rem,3vw,2.5rem) auto clamp(2rem,4vw,3.5rem); }
  .carousel-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 0 0 .85rem; padding: 0 .35rem; }
  .carousel-eyebrow { display: inline-flex; align-items: center; gap: .65rem; color: #41627f; font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .carousel-eyebrow i { width: 8px; height: 8px; border-radius: 50%; background: #13abd5; box-shadow: 0 0 0 5px rgba(19,171,213,.12); }
  .carousel-counter { color: #17375a; font-size: .8rem; font-weight: 800; letter-spacing: .1em; font-variant-numeric: tabular-nums; }
  .carousel-counter span { padding: 0 .35rem; color: #a8b8c9; }
  .carousel-stage { position: relative; isolation: isolate; width: 100%; aspect-ratio: 1.97 / 1; max-height: 710px; overflow: hidden; border: 1px solid rgba(255,255,255,.8); border-radius: clamp(18px,2.4vw,34px); background: linear-gradient(135deg,#182f81,#158ac5); box-shadow: 0 28px 70px rgba(9,42,86,.22); touch-action: pan-y; }
  .carousel-slide { position: absolute; inset: 0; z-index: 0; overflow: hidden; opacity: 0; transform: scale(1.025); transition: opacity .85s ease,transform 1.1s cubic-bezier(.2,.7,.2,1); pointer-events: none; }
  .carousel-slide.is-active { z-index: 1; opacity: 1; transform: scale(1); pointer-events: auto; }
  .carousel-slide img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .carousel-slide.is-active img { animation: carousel-drift 6.5s ease-out both; }
  .carousel-slide.slide-anniversary { display: grid; place-items: center; background: radial-gradient(ellipse at 50% 45%,#284d8d 0,#142b66 55%,#101e50 100%); }
  .carousel-slide.slide-anniversary img { width: 62%; height: 88%; object-fit: contain; filter: drop-shadow(0 24px 35px rgba(0,0,0,.24)); }
  .stage-shade { position: absolute; z-index: 2; inset: 0; pointer-events: none; background: linear-gradient(110deg,rgba(6,22,48,.12),transparent 40%,rgba(8,25,53,.12)),linear-gradient(0deg,rgba(6,20,46,.2),transparent 32%); }
  .carousel-orbit { position: absolute; z-index: 3; width: 230px; height: 230px; border: 1px solid rgba(255,255,255,.17); border-radius: 50%; pointer-events: none; animation: orbit-in 1.6s ease-out both; }
  .orbit-a { top: -150px; right: 15%; }.orbit-b { right: 5%; bottom: -190px; width: 290px; height: 290px; border-color: rgba(255,255,255,.11); }
  .stage-spark { position: absolute; z-index: 3; width: 6px; height: 6px; border-radius: 50%; background: #78eaff; box-shadow: 0 0 18px 5px rgba(81,222,250,.55); pointer-events: none; animation: sparkle 3s ease-in-out infinite; }
  .spark-one { top: 22%; right: 22%; }.spark-two { right: 38%; bottom: 23%; width: 4px; height: 4px; animation-delay: 1.2s; }
  .carousel-toolbar { display: flex; align-items: center; justify-content: center; gap: .7rem; width: fit-content; max-width: 100%; margin: -1.2rem auto 0; padding: .55rem .65rem; position: relative; z-index: 4; border: 1px solid rgba(255,255,255,.8); border-radius: 999px; background: rgba(255,255,255,.92); box-shadow: 0 14px 36px rgba(22,57,94,.13); backdrop-filter: blur(15px); }
  .carousel-control { display: grid; flex: 0 0 auto; width: 38px; height: 38px; place-items: center; border: 0; border-radius: 50%; background: #eef6fb; color: #164b76; cursor: pointer; transition: color .2s,background .2s,transform .2s; }
  .carousel-control:hover { transform: translateY(-2px); background: #087fc1; color: #fff; }
  .carousel-control svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .play-icon { display: none; }.is-paused .pause-icon { display: none; }.is-paused .play-icon { display: block; }
  .carousel-dots { display: flex; align-items: center; gap: .28rem; padding: 0 .25rem; }
  .carousel-dot { display: grid; width: 24px; height: 30px; place-items: center; border: 0; background: none; cursor: pointer; }
  .carousel-dot span { width: 7px; height: 7px; border-radius: 9px; background: #b9c8d5; transition: width .35s ease,background .3s ease; }
  .carousel-dot.is-active span { width: 23px; background: #087fc1; }
  .carousel-control:focus-visible,.carousel-dot:focus-visible { outline: 3px solid #42cbea; outline-offset: 3px; }
  @keyframes carousel-drift { from { transform: scale(1.025); } to { transform: scale(1.09); } }
  @keyframes orbit-in { from { opacity: 0; transform: scale(.7) rotate(-12deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
  @keyframes sparkle { 0%,100% { opacity: .4; transform: scale(.75); } 50% { opacity: 1; transform: scale(1.45); } }
  @media (max-width: 700px) {
    .hero-carousel { width: calc(100% - 1.25rem); margin-top: 1.1rem; }
    .carousel-stage { aspect-ratio: 1.52 / 1; max-height: none; }
    .carousel-slide img { object-fit: contain; }
    .carousel-slide.slide-anniversary img { width: 72%; height: 91%; }
    .carousel-toolbar { gap: .35rem; margin-top: -.9rem; padding: .4rem .45rem; }
    .carousel-control { width: 34px; height: 34px; }
    .carousel-dot { width: 19px; height: 28px; }
    .carousel-dot.is-active span { width: 17px; }
    .carousel-orbit { width: 170px; height: 170px; }
    .orbit-a { top: -110px; }.orbit-b { bottom: -140px; width: 220px; height: 220px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-slide,.carousel-slide img,.carousel-orbit,.stage-spark,.carousel-control,.carousel-dot span { animation: none !important; transition: none !important; }
    .carousel-slide { transform: none; }
    .carousel-slide.is-active img { transform: none; }
  }
</style>
