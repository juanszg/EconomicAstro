---
interface Props { title: string; description: string; detail: string; imageSrc: string; imageAlt?: string; number?: string; serviceId: string; }
const { title, description, detail, imageSrc, imageAlt = "", number, serviceId } = Astro.props;
---
<details class="service-card" data-service-id={serviceId}>
  <summary class="card-summary">
    <span class="card-icon"><img src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" /></span>
    <span class="card-content">
      <span class="card-number">{number}</span>
      <span class="card-title">{title}</span>
      <span class="card-description">{description}</span>
      <span class="expand-hint"><span class="expand-symbol" aria-hidden="true">＋</span> Ver detalles</span>
    </span>
  </summary>
  <div class="card-expanded">
    <p>{detail}</p>
    <button type="button" class="card-pick" data-pick-service={serviceId}>Agregar a mi cotización</button>
  </div>
</details>
<style>
  .service-card { position: relative; z-index: 0; min-width: 0; overflow: hidden; border: 1px solid rgba(255,255,255,.24); border-radius: 24px; background: linear-gradient(135deg,#087fc1,#0666a9); color: white; box-shadow: 0 12px 24px rgba(3,77,126,.14); transition: transform .3s ease,box-shadow .3s ease,border-color .3s ease; }
  .service-card::after { position: absolute; right: -45px; bottom: -70px; z-index: 0; width: 180px; height: 180px; border-radius: 50%; background: rgba(89,211,243,.12); content: ""; transition: transform .4s ease; pointer-events: none; }
  .service-card:hover,.service-card[open] { z-index: 2; transform: translateY(-4px); border-color: rgba(255,255,255,.6); box-shadow: 0 20px 34px rgba(3,77,126,.25); }
  .service-card:hover::after,.service-card[open]::after { transform: scale(1.35); }
  .card-summary { position: relative; z-index: 1; display: grid; grid-template-columns: 112px minmax(0,1fr); align-items: center; gap: 1rem; min-height: 190px; padding: 1.25rem 1.4rem; cursor: pointer; list-style: none; }
  .card-summary::-webkit-details-marker { display: none; }
  .card-summary::marker { content: ""; }
  .card-icon { position: relative; z-index: 1; display: grid; place-items: center; width: 112px; height: 132px; overflow: visible; background: transparent; }
  .card-icon img { display: block; width: 142px; max-width: none; height: 142px; object-fit: contain; transform: scale(1.02); filter: drop-shadow(0 12px 18px rgba(0,28,55,.25)); -webkit-mask-image: linear-gradient(90deg,#000 0%,#000 48%,rgba(0,0,0,.75) 67%,transparent 100%); mask-image: linear-gradient(90deg,#000 0%,#000 48%,rgba(0,0,0,.75) 67%,transparent 100%); transition: transform .35s ease; }
  .service-card:hover .card-icon img,.service-card[open] .card-icon img { transform: scale(1.12); }
  .card-content { position: relative; z-index: 1; display: block; min-width: 0; }
  .card-number { color: #a8e8f8; font-size: .65rem; font-weight: 800; letter-spacing: .18em; }
  .card-title { display: block; margin: .4rem 0 .5rem; color: #fff; font-family: 'Montserrat',sans-serif; font-size: 1rem; font-weight: 800; line-height: 1.35; letter-spacing: .01em; }
  .card-description { display: block; color: #e6f4ff; font-size: .82rem; line-height: 1.65; }
  .expand-hint { display: inline-flex; align-items: center; gap: .35rem; margin-top: .65rem; color: #bfefff; font-size: .72rem; font-weight: 800; }
  .expand-symbol { display: grid; place-items: center; width: 1.15rem; height: 1.15rem; border-radius: 50%; background: rgba(255,255,255,.16); font-size: .9rem; transition: transform .25s ease; }
  .service-card[open] .expand-symbol { transform: rotate(45deg); }
  .card-expanded { position: relative; z-index: 1; padding: 0 1.4rem 1.35rem calc(112px + 2.4rem); animation: reveal .25s ease both; }
  .card-expanded p { margin: 0 0 .9rem; color: #f1f8ff; font-size: .84rem; line-height: 1.7; }
  .card-pick { padding: .7rem 1rem; border: 0; border-radius: 999px; background: #fff; color: #075b91; font: 800 .78rem 'Montserrat',sans-serif; cursor: pointer; box-shadow: 0 5px 14px rgba(0,30,58,.18); transition: transform .2s ease,background .2s ease; }
  .card-pick:hover { transform: translateY(-2px); background: #d8f5ff; }
  .card-pick[aria-pressed="true"] { background: #c9f7d8; color: #125b35; }
  @keyframes reveal { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 520px) {
    .card-summary { grid-template-columns: 74px minmax(0,1fr); gap: .65rem; min-height: 154px; padding: 1rem .9rem; }
    .card-icon { width: 74px; height: 110px; }
    .card-icon img { width: 116px; height: 116px; transform: scale(1.05); }
    .service-card:hover .card-icon img,.service-card[open] .card-icon img { transform: scale(1.16); }
    .card-title { font-size: .91rem; }
    .card-description { font-size: .78rem; line-height: 1.55; }
    .card-expanded { padding: 0 1rem 1.1rem calc(74px + 1.65rem); }
  }
  @media (prefers-reduced-motion: reduce) { .service-card,.service-card::after,.card-icon img,.expand-symbol { transition: none; } .card-expanded { animation: none; } }
</style>
