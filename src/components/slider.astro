---
const photos = Array.from({ length: 30 }, (_, index) => ({
  src: `/media/gallery/entrega-${String(index + 1).padStart(2, "0")}.webp`,
  alt: `Entrega de equipo y proyecto tecnológico de Economic Sales, registro ${index + 1}`,
}));
---
<section class="delivery-gallery" aria-labelledby="gallery-title" data-gallery>
  <header class="gallery-heading">
    <div>
      <span class="gallery-eyebrow"><i></i> Experiencia en acción</span>
      <h2 id="gallery-title">Tecnología que llega más lejos</h2>
      <p>Un recorrido por proyectos, entregas y equipos que ya están en marcha.</p>
    </div>
    <button class="gallery-toggle" type="button" aria-label="Pausar galería" aria-pressed="false" data-gallery-toggle>
      <svg class="gallery-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
      <svg class="gallery-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
      <span data-gallery-toggle-label>Pausar</span>
    </button>
  </header>
  <div class="gallery-window">
    <div class="gallery-track">
      <div class="gallery-group">
        {photos.map((photo, index) => <figure class="gallery-card">
          <img src={photo.src} alt={photo.alt} loading={index < 4 ? "eager" : "lazy"} decoding="async" />
          <figcaption><span>Economic Sales</span><b>{String(index + 1).padStart(2, "0")}</b></figcaption>
        </figure>)}
      </div>
      <div class="gallery-group gallery-copy" aria-hidden="true">
        {photos.map((photo, index) => <figure class="gallery-card">
          <img src={photo.src} alt="" loading="lazy" decoding="async" />
          <figcaption><span>Economic Sales</span><b>{String(index + 1).padStart(2, "0")}</b></figcaption>
        </figure>)}
      </div>
    </div>
  </div>
</section>
<script>
  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  const galleryToggle = gallery?.querySelector<HTMLButtonElement>("[data-gallery-toggle]");
  const galleryLabel = gallery?.querySelector<HTMLElement>("[data-gallery-toggle-label]");

  galleryToggle?.addEventListener("click", () => {
    const isPaused = gallery?.classList.toggle("is-paused") ?? false;
    galleryToggle.setAttribute("aria-pressed", String(isPaused));
    galleryToggle.setAttribute("aria-label", isPaused ? "Reanudar galería" : "Pausar galería");
    if (galleryLabel) galleryLabel.textContent = isPaused ? "Reanudar" : "Pausar";
  });
</script>
<style>
  .delivery-gallery { position: relative; overflow: hidden; padding: clamp(2.5rem,5vw,4.5rem) 0 clamp(3rem,6vw,5.5rem); background: linear-gradient(180deg,#f7fbff 0%,#edf5fb 100%); }
  .gallery-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; width: min(100% - 2rem,1280px); margin: 0 auto 1.7rem; }
  .gallery-eyebrow { display: inline-flex; align-items: center; gap: .6rem; color: #0878c9; font-size: .68rem; font-weight: 800; letter-spacing: .17em; text-transform: uppercase; }
  .gallery-eyebrow i { width: 7px; height: 7px; border-radius: 50%; background: #15b5d7; box-shadow: 0 0 0 5px rgba(21,181,215,.12); }
  .gallery-heading h2 { margin: .55rem 0 .4rem; color: #112c4b; font-size: clamp(1.55rem,3vw,2.35rem); line-height: 1.2; letter-spacing: -.04em; }
  .gallery-heading p { margin: 0; color: #61758b; font-size: .92rem; line-height: 1.65; }
  .gallery-toggle { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; gap: .55rem; min-height: 42px; padding: .65rem .9rem; border: 1px solid #d9e7f1; border-radius: 999px; background: rgba(255,255,255,.82); color: #31536f; font: 700 .78rem 'Montserrat',sans-serif; cursor: pointer; transition: border-color .2s,color .2s,background .2s; }
  .gallery-toggle:hover { border-color: #087fc1; background: #fff; color: #0878c9; }
  .gallery-toggle svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .gallery-play { display: none; }.is-paused .gallery-pause { display: none; }.is-paused .gallery-play { display: block; }
  .gallery-window { position: relative; overflow: hidden; width: 100%; padding: .55rem 0 1.25rem; mask-image: linear-gradient(90deg,transparent 0,#000 5%,#000 95%,transparent 100%); }
  .gallery-track { display: flex; width: max-content; animation: gallery-scroll 78s linear infinite; will-change: transform; }
  .gallery-group { display: flex; align-items: stretch; gap: 1rem; flex: 0 0 auto; padding-right: 1rem; }
  .gallery-card { position: relative; flex: 0 0 clamp(220px,23vw,305px); aspect-ratio: 1.48 / 1; margin: 0; overflow: hidden; border: 1px solid rgba(255,255,255,.9); border-radius: 19px; background: #dce9f3; box-shadow: 0 12px 28px rgba(15,46,79,.12); transition: transform .35s ease,box-shadow .35s ease; }
  .gallery-card:hover { z-index: 1; transform: translateY(-5px) scale(1.025); box-shadow: 0 20px 38px rgba(15,46,79,.2); }
  .gallery-card img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform .6s cubic-bezier(.2,.8,.2,1),filter .4s ease; }
  .gallery-card:hover img { transform: scale(1.07); filter: saturate(1.08); }
  .gallery-card figcaption { position: absolute; right: .65rem; bottom: .65rem; left: .65rem; display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .55rem .7rem; border: 1px solid rgba(255,255,255,.35); border-radius: 11px; background: rgba(8,28,54,.58); color: white; font-size: .64rem; font-weight: 700; letter-spacing: .05em; backdrop-filter: blur(12px); }
  .gallery-card figcaption b { color: #a9e9f8; font-size: .65rem; letter-spacing: .12em; }
  .delivery-gallery:hover .gallery-track,.delivery-gallery:focus-within .gallery-track,.delivery-gallery.is-paused .gallery-track { animation-play-state: paused; }
  .gallery-toggle:focus-visible { outline: 3px solid #3fc9ea; outline-offset: 3px; }
  @keyframes gallery-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (max-width: 680px) {
    .gallery-heading { align-items: flex-start; }
    .gallery-toggle { width: 42px; min-width: 42px; padding: 0; font-size: 0; }
    .gallery-toggle svg { width: 18px; height: 18px; }
    .gallery-card { flex-basis: 245px; }
    .gallery-group { gap: .75rem; padding-right: .75rem; }
    .gallery-track { animation-duration: 68s; }
    .gallery-window { mask-image: linear-gradient(90deg,transparent 0,#000 4%,#000 96%,transparent 100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-track { animation: none; }
    .gallery-window { overflow-x: auto; scroll-snap-type: x mandatory; }
    .gallery-card { scroll-snap-align: center; }
    .gallery-card,.gallery-card img,.gallery-toggle { transition: none; }
  }
</style>
