---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Slider from "../components/slider.astro";
import Carrusel from "../components/Carrusel.astro";
---

<!-- hola ES LA RAMA DE JUAN  -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<Layout title="ECONOMIC SALES DE MEXICO SA DE CV">
	<!-- <main>  
		<!-- <NavPop />
	</main>
     -->
		
	<!-- MENU  -->
		<!-- La navegación y el pie de página se comparten desde Layout. -->
		<div class="home-brand-banner">
			<img src="/economic-sales-banner.gif" alt="Economic Sales de México" fetchpriority="high" decoding="async" />
		</div>
		<Carrusel />
		<div class="contenedor1">
			<div class="textoec">
				<h3> 
					Llevamos la vanguardia tecnológica <br />a personas
					extraordinarias
				</h3>
			</div>
			<div class="videoyt">
				<iframe
					width="85%"
					height="400px"
					src="https://www.youtube.com/embed/t-6oJIv1nKE?si=eZqJp615UAnHF_Rj"
					title="YouTube video player"
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen></iframe>
			</div>
			<Slider />
			<Card />
			<!-- <Whats/> -->
		</div>
	<!-- <Footer /> -->
</Layout>

<style>
	main {
		padding: 0px;
		margin: 0px;
		/*margin: auto;*/
		padding: 1rem;
		/*width: 800px;*/
		width: 100%;
		max-width: calc(100% - 2rem);
		color: white;
		font-size: 20px;
		line-height: 1.6;
	}
	body {
		padding: 0px;
		margin: 0px;
		font-family: "Montserrat", sans-serif;
		background-color: #FFF8ED !important;
	
	}
	.boton-dark{
		z-index: 999 !important;

	}
	.contenedor1 {
		width: 100%;
		padding: clamp(2.5rem, 5vw, 5rem) 0 0;
		align-items: center;
		border: 0;
		background: #fff8ed;
	}
	.home-brand-banner {
		width: min(100% - 2rem, 1480px);
		margin: clamp(1rem, 2.5vw, 2rem) auto 0;
		overflow: hidden;
		border-radius: clamp(1rem, 2vw, 1.75rem);
		background: #fff;
		box-shadow: 0 18px 48px rgba(19, 35, 58, .14);
	}
	.home-brand-banner img { display: block; width: 100%; height: auto; }
	.barra{
       display: none;
        width: 100%;
        background-color: rgb(0, 0, 175);
        height: 160px;
        text-align: center;
        padding-top: 1em;
    }
    .barra img{
        max-width: 95%;
        height:80%;
    }
	/* .nav-pop {
        visibility: hidden;
    } */
	.textoec {
		animation: fade 1.5s ease-in-out;
		font-size: 2.2em;
		/*text-shadow: 2px 2px 0px black;*/
		margin: 25px;
	}
	@media (max-width:645px){
	 .textoec{
		font-size: 1.2em;
	 }
	}
	@media (max-width:445px){
	 .textoec{
		font-size: .8em;
		margin: 0px
	 }
	}
	.videoyt {
		text-align: center;
		margin-bottom: 5em;
	}

	.videoyt iframe {
		border-radius: 1.5em;
		margin-top: 1em;
	}

	.textoec h3 {
		color: #60b5ff;
		text-align: center;
		font-size: 1.6em;
		font-family: montserrat;
		font-weight: 900;
	}
	h1 {
		font-size: 4rem;
		font-weight: 700;
		line-height: 1;
		text-align: center;
		margin-bottom: 1em;
	}
