---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/serviceCard.astro";
const services = [
  { title: "Venta de equipo de cómputo", description: "Equipos de escritorio, laptops, periféricos y accesorios configurados para las necesidades de tu empresa.", icon: "Iconos.png", alt: "Computadora y equipo tecnológico" },
  { title: "Bot API de correos automatizados con IA", description: "Automatiza la investigación de prospectos, la redacción de mensajes y el envío de campañas desde tu marca.", icon: "Iconos 2.png", alt: "Inteligencia artificial y automatización" },
  { title: "Alianzas empresariales", description: "Programas de adquisición de tecnología para colaboradores con opciones y precios preferenciales.", icon: "Iconos 3.png", alt: "Alianza empresarial" },
  { title: "Colaboración y videoconferencias", description: "Diseño y configuración de salas, plataformas de reuniones y equipos para conectar a tus equipos.", icon: "Iconos 4.png", alt: "Videoconferencia empresarial" },
  { title: "Servidores y centros de datos", description: "Infraestructura, respaldo, virtualización y migración de datos para mantener tu operación disponible.", icon: "Iconos 5.png", alt: "Servidor y centro de datos" },
  { title: "Psicología organizacional", description: "Consultoría para fortalecer el clima laboral, facilitar acuerdos y mejorar la productividad.", icon: "Iconos 6.png", alt: "Personas y organización" },
  { title: "Redes y conectividad", description: "Instalación, configuración y monitoreo de redes, VPN y conectividad para tus espacios de trabajo.", icon: "Iconos 16.png", alt: "Conectividad de red" },
  { title: "Soluciones en la nube", description: "Migración y configuración de servicios cloud, nube privada y recuperación ante contingencias.", icon: "Iconos 8.png", alt: "Servicios en la nube" },
  { title: "Seguridad física", description: "Cámaras, control de acceso y monitoreo perimetral para proteger instalaciones y activos.", icon: "Iconos 9.png", alt: "Cámara de seguridad" },
  { title: "Ciberseguridad", description: "Protección de endpoints, gestión de firewall y herramientas para reducir riesgos digitales.", icon: "Iconos 10.png", alt: "Escudo de ciberseguridad" },
  { title: "Captura de datos y puntos de venta", description: "Implementación y soporte de terminales, lectores y soluciones para agilizar tus operaciones.", icon: "Iconos 11.png", alt: "Terminal de punto de venta" },
  { title: "Tecnología, soporte y soluciones a medida", description: "Software, diseño web, reparación, instalación, arrendamiento y financiamiento de equipos.", icon: "Iconos 12.png", alt: "Soluciones de tecnología" },
];
---
<Layout title="Servicios" description="Conoce los servicios de Economic Sales: equipo, nube, redes, ciberseguridad, IA y soluciones para empresas.">
  <section class="services-page">
    <header class="services-hero"><span class="eyebrow">Soluciones para tu empresa</span><h1>Servicios que conectan<br /><span>tecnología con resultados.</span></h1><p>Desde el equipo que tu operación necesita hasta soluciones especializadas para crecer con seguridad.</p></header>
    <div class="services-grid">{services.map((service, index) => <ServiceCard title={service.title} description={service.description} imageSrc={`/img-servicios/${service.icon}`} imageAlt={service.alt} number={String(index + 1).padStart(2, "0")} />)}</div>
    <aside class="services-contact"><p>¿Buscas una solución distinta?</p><a href="/contacto">Cuéntanos qué necesitas <span aria-hidden="true">→</span></a></aside>
  </section>
</Layout>
<style>
  .services-page { padding: 0 clamp(1rem,5vw,5rem) 5rem; background: radial-gradient(ellipse at 12% 0%,#e2f5ff 0,transparent 35%),#f5f8fc; }
  .services-hero { max-width: 920px; margin: auto; padding: clamp(4rem,9vw,7rem) 0 3.2rem; text-align: center; }
  .eyebrow { color: #0878c9; font-size: .72rem; font-weight: 800; letter-spacing: .19em; text-transform: uppercase; }
  .services-hero h1 { margin: 1rem 0; color: #112c4b; font-size: clamp(2.25rem,5vw,4.2rem); line-height: 1.1; letter-spacing: -.055em; }.services-hero h1 span { color: #0788ca; }
  .services-hero p { max-width: 680px; margin: auto; color: #61758b; font-size: 1.05rem; line-height: 1.8; }
  .services-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.1rem; max-width: 1200px; margin: auto; }
  .services-contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .6rem 1rem; margin: 2.5rem auto 0; color: #5e7188; text-align: center; }.services-contact p { margin: 0; }.services-contact a { color: #0878c9; font-weight: 800; text-decoration: none; }
  @media (max-width: 780px) { .services-grid { grid-template-columns: 1fr; max-width: 650px; } }
</style>
