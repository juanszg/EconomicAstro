---
import Layout from "../layouts/Layout.astro";
const recognitions = [
  { image: "/media/patrocinio-ipn.webp", alt: "Reconocimiento de patrocinio de Economic Sales en el IPN", tag: "Deporte y comunidad", title: "Carrera 11K del Instituto Politécnico Nacional", text: "Nos sumamos como patrocinadores a una iniciativa que celebra el esfuerzo, la salud y el orgullo de la comunidad politécnica." },
  { image: "/media/patrocinio-carrera.webp", alt: "Cartel de la carrera 11K del Instituto Politécnico Nacional", tag: "Compromiso institucional", title: "Impulsamos el talento y la participación", text: "Acompañamos un encuentro que reúne a estudiantes, egresados y familias alrededor de una meta compartida." },
  { image: "/media/patrocinio-idx.webp", alt: "Economic Sales presente en el evento de tecnología IDX", tag: "Innovación y tecnología", title: "Presentes en IDX, el encuentro tecnológico", text: "Participamos en espacios que acercan a las empresas a nuevas ideas, soluciones y tendencias del sector tecnológico." },
];
---
<Layout title="Patrocinios" description="Reconocimientos, patrocinios e iniciativas que reflejan el compromiso de Economic Sales con México.">
  <section class="sponsors-page">
    <header class="sponsors-hero"><span class="eyebrow">Orgullo que compartimos</span><h1>Patrocinios y reconocimientos</h1><p>Creemos en apoyar las iniciativas que conectan a las personas con el deporte, la educación y la innovación.</p><div class="hero-line"></div></header>
    <section class="recognition-list" aria-label="Reconocimientos y eventos patrocinados">
      {recognitions.map((item, index) => <article class:list={["recognition", index % 2 ? "reverse" : ""]}>
        <div class="recognition-visual"><div class="image-glow"></div><img src={item.image} alt={item.alt} loading="lazy" decoding="async" /></div>
        <div class="recognition-copy"><span class="recognition-tag"><span></span>{item.tag}</span><span class="recognition-number">0{index + 1}</span><h2>{item.title}</h2><p>{item.text}</p><div class="recognition-rule"></div><span class="recognition-signature">Economic Sales de México</span></div>
      </article>)}
    </section>
    <section class="sponsors-cta"><span class="eyebrow">Crecer en comunidad</span><h2>Las mejores alianzas crean impacto.</h2><p>¿Tu organización prepara una iniciativa que vale la pena impulsar?</p><a href="/contacto">Hablemos de tu proyecto <span aria-hidden="true">→</span></a></section>
  </section>
</Layout>
<style>
  .sponsors-page { overflow: hidden; padding: 0 clamp(1.1rem,6vw,6rem) 5rem; background: radial-gradient(ellipse at 80% 0%,#e3f5ff 0,transparent 35%),#f5f8fc; }
  .sponsors-hero { position: relative; max-width: 980px; margin: auto; padding: clamp(4rem,10vw,7rem) 0 3rem; text-align: center; }
  .eyebrow { color: #0878c9; font-size: .72rem; font-weight: 800; letter-spacing: .19em; text-transform: uppercase; }
  .sponsors-hero h1 { margin: .8rem 0; color: #112c4b; font-size: clamp(2.3rem,5vw,4.6rem); line-height: 1.08; letter-spacing: -.055em; }
  .sponsors-hero p { max-width: 680px; margin: auto; color: #61758b; font-size: 1.1rem; line-height: 1.8; }
  .hero-line { width: 62px; height: 4px; margin: 2rem auto 0; border-radius: 4px; background: linear-gradient(90deg,#06a5dc,#3157ca); }
  .recognition-list { max-width: 1160px; margin: auto; }
  .recognition { display: grid; grid-template-columns: 1.08fr .92fr; align-items: center; gap: clamp(2rem,7vw,7rem); padding: 3.2rem 0; }
  .recognition.reverse .recognition-visual { order: 2; }.recognition.reverse .recognition-copy { order: 1; }
  .recognition-visual { position: relative; display: grid; min-height: 300px; place-items: center; padding: 1rem; isolation: isolate; }
  .recognition-visual img { position: relative; z-index: 1; display: block; width: 100%; max-height: 420px; object-fit: contain; border-radius: 22px; filter: drop-shadow(0 20px 28px rgba(18,48,80,.18)); transition: transform .7s cubic-bezier(.2,.8,.2,1),filter .7s; }
  .recognition:hover .recognition-visual img { transform: translateY(-7px) scale(1.035) rotate(-1deg); filter: drop-shadow(0 28px 36px rgba(18,48,80,.24)); }
  .image-glow { position: absolute; z-index: -1; inset: 12% 10%; border-radius: 50%; background: radial-gradient(ellipse,#aeeaff 0,rgba(174,234,255,0) 70%); filter: blur(14px); transition: transform .7s; }
  .recognition:hover .image-glow { transform: scale(1.18); }
  .recognition-copy { position: relative; padding: 1.5rem 0; }
  .recognition-tag { display: inline-flex; align-items: center; gap: .55rem; color: #0878c9; font-size: .72rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .recognition-tag span { width: 8px; height: 8px; border-radius: 50%; background: #12b9dd; box-shadow: 0 0 0 5px rgba(18,185,221,.12); }
  .recognition-number { position: absolute; top: 0; right: 0; color: #e1eaf4; font-size: 4rem; font-weight: 900; line-height: 1; }
  .recognition-copy h2 { position: relative; margin: 1.1rem 0 .85rem; color: #112c4b; font-size: clamp(1.65rem,3vw,2.5rem); line-height: 1.2; letter-spacing: -.04em; }
  .recognition-copy p { color: #61758b; font-size: 1rem; line-height: 1.85; }
  .recognition-rule { width: 44px; height: 3px; margin: 1.5rem 0 .8rem; border-radius: 3px; background: #22b9dc; }
  .recognition-signature { color: #8291a2; font-size: .76rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .sponsors-cta { max-width: 850px; margin: 3rem auto 0; padding: clamp(2rem,6vw,4rem); border: 1px solid #e0ebf4; border-radius: 28px; background: linear-gradient(135deg,#fff,#edf8ff); text-align: center; box-shadow: 0 20px 50px rgba(18,48,80,.07); }
  .sponsors-cta h2 { margin: .65rem 0; color: #112c4b; font-size: clamp(1.6rem,3vw,2.35rem); }.sponsors-cta p { color: #61758b; }.sponsors-cta a { display: inline-flex; gap: .7rem; margin-top: .6rem; padding: .9rem 1.2rem; border-radius: 999px; background: #0878c9; color: white; font-size: .9rem; font-weight: 750; text-decoration: none; }
  @media (max-width: 760px) { .recognition { grid-template-columns: 1fr; gap: .5rem; padding: 2.2rem 0; } .recognition.reverse .recognition-visual,.recognition.reverse .recognition-copy { order: initial; } .recognition-visual { min-height: 220px; } .recognition-visual img { max-height: 340px; } .recognition-copy { padding: .5rem .3rem 1rem; } }
  @media (prefers-reduced-motion: reduce) { .recognition-visual img,.image-glow { transition: none; } }
</style>
