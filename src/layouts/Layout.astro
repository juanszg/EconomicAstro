---
import NavFija from "../components/navFija.astro";
import Footer from "../components/Footer.astro";
import Whats from "../components/whats.astro";

interface Props { title: string; description?: string; }
const { title, description = "Soluciones de tecnología, equipo de cómputo y servicios para empresas en México." } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#294879" />
    <link rel="icon" type="image/x-icon" href="/iconominibueno.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title} | Economic Sales</title>
  </head>
  <body>
    <NavFija />
    <main><slot /></main>
    <Whats />
    <Footer />
  </body>
</html>
<style is:global>
  :root { font-family: 'Montserrat', sans-serif; color: #13233a; background: #f5f8fc; font-synthesis: none; text-rendering: optimizeLegibility; }
  *, *::before, *::after { box-sizing: border-box; }
  html { min-width: 320px; scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; font-family: 'Montserrat', sans-serif; }
  main { min-height: 60vh; }
  img { max-width: 100%; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; } }
</style>
